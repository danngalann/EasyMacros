{
  "name": "easymacros",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter backend build",
    "dev": "pnpm --filter backend dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "pnpm --filter backend test",
    "test:backend": "pnpm --filter backend test",
    "typecheck": "pnpm --filter backend typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}
