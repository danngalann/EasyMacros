# Development-only PostgreSQL connection values. Do not put production secrets here.
POSTGRES_DB=easymacros
POSTGRES_USER=easymacros
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://easymacros:change-me-before-use@127.0.0.1:5432/easymacros
PORT=3000
HOST=127.0.0.1
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=easymacros
JWT_AUDIENCE=easymacros-mobile
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_DAYS=30
# 0 means no fixed maximum; idle expiry and revocation still apply.
SESSION_MAX_AGE_DAYS=0
REGISTRATION_ENABLED=false
PUBLIC_AUTH_RATE_LIMIT_MAX=20
# Number of directly trusted reverse-proxy hops. Leave at 0 without a proxy.
TRUSTED_PROXY_HOPS=0
# External ingredient ingestion. OFF is disabled until a real operator contact is set.
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=EasyMacros/0.1.0 (operator@example.invalid)
OPEN_FOOD_FACTS_COUNTRY=de
OPEN_FOOD_FACTS_LANGUAGE=en
# Leave blank to keep image + AI unavailable.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_ADVANCED_MODEL=google/gemini-3.7-flash
IMAGE_JOB_DIRECTORY=/tmp/easymacros-images
AI_WORKER_CONCURRENCY=2
AI_REQUESTS_PER_HOUR=10
AI_MAX_UPLOAD_BYTES=8388608
