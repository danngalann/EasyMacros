# Development-only PostgreSQL connection values. Do not put production secrets here.
POSTGRES_DB=easymacros
POSTGRES_USER=easymacros
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://easymacros:change-me-before-use@127.0.0.1:5432/easymacros
PORT=3000
HOST=127.0.0.1
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=easymacros
JWT_AUDIENCE=easymacros-mobile
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_DAYS=30
# 0 means no fixed maximum; idle expiry and revocation still apply.
SESSION_MAX_AGE_DAYS=0
REGISTRATION_ENABLED=false
PUBLIC_AUTH_RATE_LIMIT_MAX=20
# Number of directly trusted reverse-proxy hops. Leave at 0 without a proxy.
TRUSTED_PROXY_HOPS=0